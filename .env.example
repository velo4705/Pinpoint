# --- PINPOINT API CONFIGURATION ---
# Copy to `.env` in the repository root and fill in the keys you have.
# Every key is optional: the engine uses only the providers it can reach and
# falls back through the tier ladder, ending at the local CLIP bunker.

# Groq (Qwen 3.8 27B vision) -- fastest tier
GROQ_API_KEY=gsk_...

# Google Gemini (Flash family) -- deepest tier ladder
GOOGLE_API_KEY=AIza...

# OpenAI (GPT-4o vision) -- strongest single model
OPENAI_API_KEY=sk-...

# --- REDIS CACHE (OPTIONAL) ---
# The engine reads a single URL. `redis://` for local, `rediss://` for Upstash.
# Leave unset to run statelessly (no image or geocode caching).
REDIS_URL=redis://localhost:6379/0

# --- API BEHAVIOUR (OPTIONAL) ---
# Comma-separated list of allowed CORS origins. Unset = allow any origin
# (the API is public by design, and credentials are never attached).
# ALLOWED_ORIGINS=https://your-app.vercel.app

# How many models a single scan may consult. The engine asks several and
# goes with the answer they agree on, so this trades API calls for accuracy.
# 1 = fastest and cheapest, 3 = the default, 5 = most careful.
# PINPOINT_VERIFY_MODELS=3

# Maximum upload size in megabytes.
# MAX_UPLOAD_MB=12

# Per-IP request budget for the scan endpoints.
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60

# Wall-clock budget for one scan, across the whole tier ladder.
# SCAN_DEADLINE_SECONDS=90

# Set to 0 to skip pre-loading the local CLIP model at startup.
# WARM_LOCAL_BUNKER=1

# --- LOCAL MODEL EXTRAS (OPTIONAL) ---
# Hugging Face token. Only needed to raise the download rate limit when
# fetching the CLIP weights into backend/models.
# HF_TOKEN=hf_...
